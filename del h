import csv
from pathlib import Path


CSV_FIL = Path('sinnes_2014_2025_med_makstemperatur.csv')
ÅR = 2025

sommerdager = 0
høysommerdager = 0
tropedager = 0

with CSV_FIL.open(newline='', encoding='utf-8-sig') as fil:
    leser = csv.DictReader(fil, delimiter=';')

    for rad in leser:
        dato = rad['Tid(norsk normaltid)']
        if not dato.endswith(str(ÅR)):
            continue

        temperatur_verdi = rad['Maksimumstemperatur (døgn)']
        temperatur = temperatur_verdi.replace('.', '').replace(',', '.')

        try:
            maks_temp = float(temperatur)
        except ValueError:
            continue

        if maks_temp > 20:
            sommerdager += 1
        if maks_temp > 25:
            høysommerdager += 1
        if maks_temp > 30:
            tropedager += 1

print(f'Antall sommerdager i {ÅR}: {sommerdager}')
print(f'Antall høysommerdager i {ÅR}: {høysommerdager}')
print(f'Antall tropedager i {ÅR}: {tropedager}')
